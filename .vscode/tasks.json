{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Laravel: Clear Lint Cache",
            "type": "shell",
            "command": "cd HotelAntikSoreang && php artisan view:clear && php artisan config:clear && php artisan route:clear && php artisan cache:clear",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Pint Fix",
            "type": "shell",
            "command": "cd HotelAntikSoreang && ./vendor/bin/pint",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Laravel Serve + Vite",
            "type": "shell",
            "command": "cd HotelAntikSoreang && npx concurrently \"php artisan serve\" \"npm run dev\"",
            "group": "test",
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "laravel",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^$",
                    "endsPattern": ".*Development Server \\(http://"
                },
                "matches": ["Laravel ready!"]
            }
        }
    ]
}
